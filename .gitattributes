# Normalise to LF in the repo. The macOS launcher is the one that really
# matters: a CRLF shell script fails on Mac with "bash: \r: command not found".
* text=auto eol=lf

*.command text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf

*.png binary

# Generated benchmark text: committed so every contributor sends the exact same
# prompts, but it should not count towards the repo's language stats.
corpora/** linguist-generated=true

# Preserve archived captures and recorded study source checksums byte for byte.
# These files can intentionally retain the measured platform's line endings.
results/archives/** -text -whitespace
results/studies/** -text -whitespace
results/aggregates/flash-next-quality/ud4-source/*.json -text -whitespace
