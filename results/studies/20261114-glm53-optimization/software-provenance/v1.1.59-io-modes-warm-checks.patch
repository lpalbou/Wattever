+// Diagnostic snapshots never substitute a guessed free-memory value when a query fails.
+// The existing NON_LOCAL lookup matches this CUDA device by LUID (not DXGI adapter order).
+static void glm_warm_memory_snapshot(int dev, const char* phase) {
+    const cudaError_t prior = cudaPeekAtLastError();
+    int current = -1;
+    const cudaError_t device_query = cudaGetDevice(&current);
+    size_t free = 0, total = 0;
+    const cudaError_t memory_query = cudaMemGetInfo(&free, &total);
+    uint64_t budget = 0, usage = 0;
+    const bool nonlocal = glm_pin_budget(dev, budget, usage);
+    std::fprintf(stderr,
+                 "glm warm memory: CUDA%d phase=%s current_device=%d device_query=%s prior_error=%s "
+                 "cuda_memory_query=%s free_bytes=%llu total_bytes=%llu "
+                 "wddm_nonlocal_query=%s budget_bytes=%llu usage_bytes=%llu\n",
+                 dev, phase, current, cudaGetErrorString(device_query), cudaGetErrorString(prior),
+                 cudaGetErrorString(memory_query), (unsigned long long) free, (unsigned long long) total,
+                 nonlocal ? "ok" : "unavailable", (unsigned long long) budget, (unsigned long long) usage);
+    std::fflush(stderr);
+}
