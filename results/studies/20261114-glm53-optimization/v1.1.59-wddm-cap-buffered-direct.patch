+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+namespace strata::core::glmfast {
+inline uint64_t wddm_room(uint64_t budget, uint64_t usage, uint64_t reserve, uint64_t future = 0) {
+    uint64_t room = budget > usage ? budget - usage : 0;
+    room -= std::min(room, reserve);
+    room -= std::min(room, future);
+    return room;
+}
+
+// Mandatory capacity first, then proportional optional capacity. Failure never changes caps.
+inline bool wddm_part_caps(uint64_t room, const std::vector<uint64_t>& preferred,
+                           const std::vector<uint64_t>& mandatory, std::vector<uint64_t>& caps) {
+    if (preferred.size() != mandatory.size()) return false;
+    std::vector<uint64_t> result(mandatory);
+    uint64_t left = room;
+    long double optional = 0;
+    for (size_t i = 0; i < preferred.size(); ++i) {
+        if (mandatory[i] > preferred[i] || mandatory[i] > left) return false;
+        left -= mandatory[i];
+        optional += static_cast<long double>(preferred[i] - mandatory[i]);
+    }
+    for (size_t i = 0; i < preferred.size() && optional > 0; ++i) {
+        const uint64_t wanted = preferred[i] - mandatory[i];
+        const long double share = static_cast<long double>(left) * wanted / optional;
+        const uint64_t extra = std::min(wanted, share >= static_cast<long double>(left) ? left :
+                                                static_cast<uint64_t>(share));
+        result[i] += extra;
+        left -= extra;
+        optional -= static_cast<long double>(wanted);
+    }
+    caps.swap(result);
+    return true;
+}
+
+inline bool wddm_sum(const std::vector<uint64_t>& values, size_t first, uint64_t& total) {
+    total = 0;
+    for (size_t i = first; i < values.size(); ++i) {
+        if (values[i] > std::numeric_limits<uint64_t>::max() - total) return false;
+        total += values[i];
+    }
+    return true;
+}
+}  // namespace strata::core::glmfast
