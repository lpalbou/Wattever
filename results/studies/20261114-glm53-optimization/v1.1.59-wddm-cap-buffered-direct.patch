+#ifdef _WIN32
+// BUFFERED_DIRECT_EXACT_BEGIN: host-test extraction includes this production helper verbatim.
+static bool buffered_read_exact(const Glm5Model::Shard& sh, uint64_t off, size_t len,
+                                uint8_t* dst, size_t& done, DWORD& error) {
+    done = 0;
+    error = ERROR_SUCCESS;
+    // A stale/truncated shard must fail explicitly. Never replace missing expert bytes with zeros or mmap fallback.
+    if (off > sh.size || (uint64_t) len > sh.size - off) {
+        error = ERROR_HANDLE_EOF;
+        return false;
+    }
+    if (len == 0) return true;
+    if (dst == nullptr || sh.h_direct == nullptr) {
+        error = dst == nullptr ? ERROR_INVALID_PARAMETER : ERROR_INVALID_HANDLE;
+        return false;
+    }
+    struct ReadEvent {
+        HANDLE ev = nullptr;
+        DWORD error = ERROR_SUCCESS;
+        ReadEvent() {
+            ev = CreateEventA(nullptr, TRUE, FALSE, nullptr);
+            if (ev == nullptr) error = GetLastError();
+        }
+        ~ReadEvent() { if (ev != nullptr) CloseHandle(ev); }
+    };
+    static thread_local ReadEvent event;
+    if (event.ev == nullptr) {
+        error = event.error;
+        return false;
+    }
+    while (done < len) {
+        if (!ResetEvent(event.ev)) {
+            error = GetLastError();
+            return false;
+        }
+        OVERLAPPED ov{};
+        const uint64_t at = off + (uint64_t) done;
+        ov.Offset = (DWORD) at;
+        ov.OffsetHigh = (DWORD) (at >> 32);
+        ov.hEvent = event.ev;
+        const DWORD want = (DWORD) std::min<size_t>(len - done, (size_t) 1 << 30);
+        if (!ReadFile((HANDLE) sh.h_direct, dst + done, want, nullptr, &ov)) {
+            const DWORD submitted = GetLastError();
+            if (submitted != ERROR_IO_PENDING) {
+                error = submitted;
+                return false;
+            }
+        }
+        DWORD received = 0;
+        if (!GetOverlappedResult((HANDLE) sh.h_direct, &ov, &received, TRUE)) {
+            error = GetLastError();
+            return false;
+        }
+        if (received == 0 || received > want) {
+            error = received == 0 ? ERROR_HANDLE_EOF : ERROR_INVALID_DATA;
+            return false;
+        }
+        done += (size_t) received;
+    }
+    return true;
+}
