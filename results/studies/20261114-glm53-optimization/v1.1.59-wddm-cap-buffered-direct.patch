+// Read-only cap query: unlike pin_room this never allocates/probes pinned memory.
+static bool glm_wddm_available(const std::vector<int>& devices, int current, uint64_t& available) {
+    available = std::numeric_limits<uint64_t>::max();
+    const std::vector<int> selected = devices.empty() ? std::vector<int>{current} : devices;
+    for (int device : selected) {
+        uint64_t budget = 0, usage = 0;
+        if (!glm_pin_budget(device, budget, usage) || budget == 0) return false;
+        const uint64_t room = budget > usage ? budget - usage : 0;
+        available = std::min(available, room);
+        std::fprintf(stderr, "glm WDDM cap: CUDA%d Budget=%llu CurrentUsage=%llu Available=%llu\n", device,
+                     (unsigned long long) budget, (unsigned long long) usage, (unsigned long long) room);
+    }
+    return true;
+}
