{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wattever benchmark session v2",
  "description": "One file records a benchmark and execution sessions. Hardware attribution distinguishes inference host from benchmark client. Unknown values remain null; reported claims are not verified measurements.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "created_at",
    "status",
    "application",
    "hardware",
    "classification",
    "measurement_scope",
    "gpu",
    "host",
    "config",
    "corpus",
    "results"
  ],
  "properties": {
    "measurement_mode": {
      "enum": [
        "helper"
      ]
    },
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "cancelled",
        "error",
        "interrupted"
      ]
    },
    "application": {
      "type": "object",
      "required": [
        "name",
        "version",
        "protocol_version"
      ]
    },
    "hardware": {
      "type": "object",
      "required": [
        "os",
        "cpu",
        "system",
        "gpus"
      ],
      "properties": {
        "transfer_bandwidth": {"$ref": "#/$defs/transferBandwidth"},
        "os": {
          "type": "object",
          "required": [
            "name",
            "release",
            "architecture"
          ]
        },
        "cpu": {
          "type": "object",
          "required": [
            "name",
            "physical_cores",
            "logical_cores"
          ]
        },
        "system": {
          "type": "object",
          "required": [
            "manufacturer",
            "model",
            "memory_bytes"
          ]
        },
        "gpus": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "vendor",
              "memory_bytes",
              "driver",
              "sensor_index"
            ]
          }
        },
        "motherboard": {
          "type": "object",
          "required": [
            "manufacturer",
            "model"
          ]
        },
        "firmware": {
          "type": "object",
          "required": [
            "vendor",
            "version"
          ]
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model",
              "capacity_bytes",
              "interface"
            ]
          }
        },
        "metadata_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "collection": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string"
            },
            "inference_server_hardware_verified": {
              "type": "boolean"
            }
          }
        },
        "memory": {
          "type": "object",
          "description": "Allowlisted DIMM reports; module count does not establish channels. Bandwidth is null unless measured."
        }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "hardware_class",
        "gpu_names",
        "platform"
      ]
    },
    "measurement_scope": {
      "type": "object",
      "required": [
        "power_gpu_sensor_index",
        "power_boundary",
        "runtime_gpu_placement",
        "runtime_gpu_placement_source"
      ]
    },
    "gpu": {
      "type": "object"
    },
    "host": {
      "type": "object"
    },
    "config": {
      "type": "object",
      "required": [
        "models",
        "sizes",
        "concurrency_levels"
      ],
      "properties": {
        "concurrency_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "provider": {
          "enum": [
            "lmstudio",
            "openai"
          ]
        },
        "endpoint_label": {
          "type": "string",
          "maxLength": 120
        },
        "endpoint_inference_local": {
          "type": "boolean"
        },
        "reproducibility": {
          "$ref": "#/$defs/reproducibility"
        },
        "performance_claims": {
          "$ref": "#/$defs/performanceClaims"
        },
        "endpoint_reasoning_effort": {
          "enum": [
            null,
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "endpoint_id": {
          "type": "string",
          "maxLength": 120
        },
        "canonical_model_id": {
          "type": "string",
          "maxLength": 250
        },
        "reported_mtp": {
          "enum": [
            "on",
            "off",
            "unknown"
          ]
        },
        "reported_reasoning": {
          "type": "string"
        },
        "token_limit_field": {
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "corpus": {
      "type": "object",
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "config",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "config": {
            "type": "object"
          },
          "application": {
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "enum": [
              "running",
              "completed",
              "cancelled",
              "error",
              "interrupted"
            ]
          }
        }
      }
    },
    "active_session_id": {
      "type": "string"
    },
    "execution_config": {
      "type": "object"
    },
    "previous_attempts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "remaining_tests": {
      "type": "integer",
      "minimum": 0
    },
    "provider": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "lmstudio",
            "openai"
          ]
        },
        "label": {
          "type": "string"
        },
        "model_management": {
          "enum": [
            "lms_cli",
            "external"
          ]
        },
        "context_control": {
          "type": "boolean"
        },
        "mtp_control": {
          "type": "boolean"
        }
      }
    },
    "measurement_client": {
      "type": "object",
      "description": "Inventory of the load-generating client. It is not evidence of remote inference hardware."
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "source",
        "settings"
      ],
      "properties": {
        "source": {
          "const": "user_reported"
        },
        "settings": {
          "$ref": "#/$defs/reproducibility"
        }
      }
    },
    "performance_claims": {
      "$ref": "#/$defs/performanceClaims"
    },
    "model_configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint_version",
          "configuration_id",
          "model",
          "quantization",
          "reasoning",
          "mtp",
          "endpoint"
        ]
      }
    },
    "telemetry": {
      "type": "object",
      "description": "Local client observations; recent ring history and whole-run coverage-aware summary."
    }
  },
  "$defs": {
    "transferBandwidth": {
      "type": "object",
      "required": ["schema_version", "protocol", "captured_at", "scope", "unit", "storage_to_ram", "ram_to_vram"],
      "properties": {
        "schema_version": {"const": 1},
        "protocol": {"const": "wattever-transfer-v1"},
        "captured_at": {"type": "string", "format": "date-time"},
        "scope": {"const": "benchmark_client"},
        "unit": {"const": "bytes_per_second"},
        "storage_to_ram": {"$ref": "#/$defs/transferMeasurement"},
        "ram_to_vram": {"$ref": "#/$defs/transferMeasurement"},
        "provenance": {"enum": ["measured_before_session", "measured_later_on_matching_hardware"]}
      }
    },
    "transferMeasurement": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["ok", "unavailable"]}},
      "allOf": [
        {"if": {"properties": {"status": {"const": "ok"}}},
         "then": {"required": ["bytes_per_second", "statistic", "method", "samples"],
          "properties": {
            "bytes_per_second": {"type": "number", "exclusiveMinimum": 0},
            "statistic": {"const": "median"},
            "method": {"type": "string", "minLength": 1},
            "samples": {"type": "array", "minItems": 1, "maxItems": 100,
              "items": {"type": "object", "required": ["bytes", "elapsed_s"],
                "properties": {"bytes": {"type": "integer", "minimum": 1},
                               "elapsed_s": {"type": "number", "exclusiveMinimum": 0}}}}
          }}},
        {"if": {"properties": {"status": {"const": "unavailable"}}},
         "then": {"required": ["reason"], "not": {"required": ["bytes_per_second"]},
                  "properties": {"reason": {"type": "string", "minLength": 1}}}}
      ]
    },
    "result": {
      "type": "object",
      "required": [
        "model",
        "target_tokens",
        "status",
        "concurrency"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "target_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "skipped",
            "cancelled"
          ]
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "aggregate_completion_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "aggregate_completion_tokens_estimated": {
          "type": "boolean"
        },
        "group_power": {
          "type": "object"
        },
        "cached_prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "metric_sources": {
          "type": "object"
        },
        "reported_timings": {
          "type": "object",
          "description": "Provider-reported timing fields, kept separate from client metrics."
        },
        "timing_scope": {
          "type": "object"
        },
        "decode_token_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "quantization": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "quantization_source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "quantization_method": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "quantization_method_source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "maxLength": 250
        },
        "engine_version": {
          "type": "string",
          "maxLength": 250
        },
        "model_revision": {
          "type": "string",
          "maxLength": 250
        },
        "quantization": {
          "type": "string",
          "maxLength": 250
        },
        "kv_cache_dtype": {
          "type": "string",
          "maxLength": 250
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "mtp_draft_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      }
    },
    "performanceClaims": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "precision",
          "value",
          "unit",
          "kind",
          "sparsity",
          "source",
          "execution_path"
        ],
        "properties": {
          "precision": {
            "enum": [
              "FP4",
              "INT4",
              "FP8",
              "INT8",
              "FP16",
              "BF16",
              "FP32"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "enum": [
              "TOPS",
              "TFLOP/s"
            ]
          },
          "kind": {
            "enum": [
              "advertised_peak",
              "measured",
              "estimate"
            ]
          },
          "sparsity": {
            "enum": [
              "dense",
              "sparse",
              "unknown"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "execution_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "provenance": {
            "const": "user_reported"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "precision": {
                  "enum": [
                    "INT4",
                    "INT8"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "TOPS"
                }
              }
            },
            "else": {
              "properties": {
                "unit": {
                  "const": "TFLOP/s"
                }
              }
            }
          }
        ]
      }
    }
  }
}
