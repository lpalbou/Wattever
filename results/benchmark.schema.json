{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wattever benchmark session v2",
  "description": "One file records a benchmark and execution sessions. Hardware attribution distinguishes inference host from benchmark client. Unknown values remain null; reported claims are not verified measurements.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "created_at",
    "status",
    "application",
    "hardware",
    "classification",
    "measurement_scope",
    "gpu",
    "host",
    "config",
    "corpus",
    "results"
  ],
  "properties": {
    "measurement_mode": {
      "enum": [
        "helper"
      ]
    },
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "cancelled",
        "error",
        "interrupted"
      ]
    },
    "application": {
      "type": "object",
      "required": [
        "name",
        "version",
        "protocol_version"
      ]
    },
    "hardware": {
      "type": "object",
      "required": [
        "os",
        "cpu",
        "system",
        "gpus"
      ],
      "properties": {
        "transfer_bandwidth": {"$ref": "#/$defs/transferBandwidth"},
        "os": {
          "type": "object",
          "required": [
            "name",
            "release",
            "architecture"
          ]
        },
        "cpu": {
          "type": "object",
          "required": [
            "name",
            "physical_cores",
            "logical_cores"
          ]
        },
        "system": {
          "type": "object",
          "required": [
            "manufacturer",
            "model",
            "memory_bytes"
          ]
        },
        "gpus": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "vendor",
              "memory_bytes",
              "driver",
              "sensor_index"
            ]
          }
        },
        "motherboard": {
          "type": "object",
          "required": [
            "manufacturer",
            "model"
          ]
        },
        "firmware": {
          "type": "object",
          "required": [
            "vendor",
            "version"
          ]
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model",
              "capacity_bytes",
              "interface"
            ]
          }
        },
        "metadata_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "collection": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string"
            },
            "inference_server_hardware_verified": {
              "type": "boolean"
            }
          }
        },
        "memory": {
          "type": "object",
          "description": "Allowlisted DIMM reports and dependency-free OS/firmware topology. Populated channels and active controller mode are distinct; DIMM count and bandwidth do not establish either.",
          "properties": {
            "channel_count": {"type": ["integer", "null"], "minimum": 1},
            "channel_topology": {"$ref": "#/$defs/memoryTopology"}
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "hardware_class",
        "gpu_names",
        "platform"
      ]
    },
    "measurement_scope": {
      "type": "object",
      "properties": {
        "phase_protocol": {
          "type": "string",
          "description": "Version of client-observed phase boundaries for this measurement session. Historical records may omit it."
        }
      },
      "required": [
        "power_gpu_sensor_index",
        "power_boundary",
        "runtime_gpu_placement",
        "runtime_gpu_placement_source"
      ]
    },
    "gpu": {
      "type": "object"
    },
    "host": {
      "type": "object"
    },
    "config": {
      "type": "object",
      "required": [
        "models",
        "sizes",
        "concurrency_levels"
      ],
      "properties": {
        "concurrency_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "provider": {
          "enum": [
            "lmstudio",
            "openai",
            "mixed"
          ]
        },
        "endpoint_label": {
          "type": "string",
          "maxLength": 120
        },
        "endpoint_inference_local": {
          "type": "boolean"
        },
        "reproducibility": {
          "$ref": "#/$defs/reproducibility"
        },
        "performance_claims": {
          "$ref": "#/$defs/performanceClaims"
        },
        "endpoint_reasoning_effort": {
          "enum": [
            null,
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "endpoint_id": {
          "type": "string",
          "maxLength": 120
        },
        "canonical_model_id": {
          "type": "string",
          "maxLength": 250
        },
        "reported_mtp": {
          "enum": [
            "on",
            "off",
            "unknown"
          ]
        },
        "reported_reasoning": {
          "type": "string"
        },
        "token_limit_field": {
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "corpus": {
      "type": "object",
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "storage_comparison": {
      "type": "object",
      "required": ["protocol", "baseline_label", "alternative_label", "baseline_results", "alternate_results", "rows"],
      "properties": {
        "protocol": {"const": "wattever-storage-comparison-v1"},
        "baseline_label": {"type": "string"},
        "alternative_label": {"type": "string"},
        "baseline_results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
        "alternate_results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
        "rows": {"type": "array", "maxItems": 200, "items": {"type": "object"}}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "config",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "config": {
            "type": "object"
          },
          "application": {
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "enum": [
              "running",
              "completed",
              "cancelled",
              "error",
              "interrupted"
            ]
          }
        }
      }
    },
    "active_session_id": {
      "type": "string"
    },
    "execution_config": {
      "type": "object"
    },
    "previous_attempts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "remaining_tests": {
      "type": "integer",
      "minimum": 0
    },
    "provider": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "lmstudio",
            "openai",
            "mixed"
          ]
        },
        "label": {
          "type": "string"
        },
        "model_management": {
          "enum": [
            "lms_cli",
            "external",
            "per_session"
          ]
        },
        "context_control": {
          "type": "boolean"
        },
        "mtp_control": {
          "type": "boolean"
        }
      }
    },
    "measurement_client": {
      "type": "object",
      "description": "Inventory of the load-generating client. It is not evidence of remote inference hardware."
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "source",
        "settings"
      ],
      "properties": {
        "source": {
          "const": "user_reported"
        },
        "settings": {
          "$ref": "#/$defs/reproducibility"
        }
      }
    },
    "performance_claims": {
      "$ref": "#/$defs/performanceClaims"
    },
    "model_configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint_version",
          "configuration_id",
          "model",
          "quantization",
          "reasoning",
          "mtp",
          "endpoint"
        ]
      }
    },
    "telemetry": {
      "type": "object",
      "description": "Local client observations; recent ring history and whole-run coverage-aware summary."
    }
  },
  "$defs": {
    "memoryTopology": {
      "type": "object",
      "required": ["status", "source", "method", "captured_at", "channel_count", "active_channel_count", "populated_channel_count"],
      "properties": {
        "status": {"enum": ["reported", "inferred", "detected", "unavailable"]},
        "source": {"type": ["string", "null"]},
        "method": {"type": ["string", "null"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "channel_count": {"type": ["integer", "null"], "minimum": 1},
        "populated_channel_count": {"type": ["integer", "null"], "minimum": 1},
        "active_channel_count": {"type": ["integer", "null"], "minimum": 1},
        "historical_inference_conditions_verified": {"type": "boolean"},
        "provenance": {"type": "string"}
      }
    },
    "transferBandwidth": {
      "type": "object",
      "required": ["schema_version", "protocol", "captured_at", "scope", "unit", "storage_to_ram", "ram_to_vram"],
      "properties": {
        "schema_version": {"const": 1},
        "protocol": {"const": "wattever-transfer-v1"},
        "captured_at": {"type": "string", "format": "date-time"},
        "scope": {"const": "benchmark_client"},
        "unit": {"const": "bytes_per_second"},
        "gpu_path_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "storage_to_ram": {"$ref": "#/$defs/transferMeasurement"},
        "ram_to_vram": {"$ref": "#/$defs/transferMeasurement"},
        "ram_to_vram_devices": {"type": "array", "maxItems": 32, "items": {"allOf": [
          {"$ref": "#/$defs/transferMeasurement"},
          {"type": "object", "required": ["gpu_sensor_index", "gpu_name"], "properties": {
            "gpu_sensor_index": {"type": "integer", "minimum": 0, "maximum": 255},
            "gpu_name": {"type": "string", "minLength": 1}
          }}
        ]}},
        "ram_copy_single": {"$ref": "#/$defs/transferMeasurement"},
        "ram_copy_parallel": {"$ref": "#/$defs/transferMeasurement"},
        "storage_volumes": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/transferMeasurement"}},
        "provenance": {"enum": ["measured_before_session", "measured_later_on_matching_hardware"]}
      }
    },
    "transferMeasurement": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["ok", "unavailable"]}},
      "allOf": [
        {"if": {"properties": {"status": {"const": "ok"}}},
         "then": {"required": ["bytes_per_second", "statistic", "method", "samples"],
          "properties": {
            "bytes_per_second": {"type": "number", "exclusiveMinimum": 0},
            "statistic": {"const": "median"},
            "method": {"type": "string", "minLength": 1},
            "samples": {"type": "array", "minItems": 1, "maxItems": 100,
              "items": {"type": "object", "required": ["bytes", "elapsed_s"],
                "properties": {"bytes": {"type": "integer", "minimum": 1},
                               "elapsed_s": {"type": "number", "exclusiveMinimum": 0}}}}
          }}},
        {"if": {"properties": {"status": {"const": "unavailable"}}},
         "then": {"required": ["reason"], "not": {"required": ["bytes_per_second"]},
                  "properties": {"reason": {"type": "string", "minLength": 1}}}}
      ]
    },
    "result": {
      "type": "object",
      "required": [
        "model",
        "target_tokens",
        "status",
        "concurrency"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "target_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "skipped",
            "cancelled"
          ]
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "phase_protocol": {
          "type": ["string", "null"],
          "description": "Phase boundary version for this result; absent on historical results with unknown decode end."
        },
        "wall_s": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Client-observed elapsed seconds. For a single request, this is its request duration. For a concurrent group, this runs from group dispatch to the observed end of the group, including queueing, prefill, and failed requests. If workers cannot be stopped or server cancellation cannot be verified, it is only the locally observed interval, not proof of server completion."
        },
        "requests": {
          "type": "array",
          "description": "Individual client observations; provider-reported timings remain separate. Older records may omit shared-origin timing.",
          "items": {
            "type": "object",
            "properties": {
              "start_offset_s": {
                "type": ["number", "null"],
                "minimum": 0,
                "description": "Client-observed seconds from concurrent group dispatch to this request's start. Absent or null means the shared-origin start is unknown; it must not be assumed zero."
              },
              "ttft_s": {
                "type": ["number", "null"],
                "minimum": 0,
                "description": "Client-observed seconds from this request's start to its first observed output. Add start_offset_s to place the first token on the group clock."
              },
              "wall_s": {
                "type": ["number", "null"],
                "minimum": 0,
                "description": "Client-observed request duration in seconds, relative to this request's start; it is not the concurrent group wall time."
              },
              "decode_s": {
                "type": ["number", "null"],
                "minimum": 0,
                "description": "For new observations, seconds from first to last nonempty output; null when there is no measurable interval. Historical values may include trailing transport."
              },
              "decode_token_count": {
                "type": ["integer", "null"],
                "minimum": 0,
                "description": "Scoped provider token count less one as a first-output boundary estimate; the first chunk can contain multiple tokens."
              },
              "response_tail_s": {
                "type": ["number", "null"],
                "minimum": 0,
                "description": "Time from last observed output to stream completion, when output was observed."
              }
            }
          }
        },
        "prefill_tps": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Client TTFT prefill proxy: successful prompt tokens divided by the union of request-start-to-first-observed-output intervals. Includes queueing and transport and may overlap another request's decode; not isolated engine prefill. Consult metric_sources for historical records."
        },
        "decode_tps": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Scoped decode tokens divided by the union of first-to-last-observed-output intervals, excluding prefill and trailing usage or response completion for new measurements. The first-chunk token count is unknown; subtracting one token is an estimate. Historical timings may include trailing transport."
        },
        "aggregate_completion_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "aggregate_completion_tokens_estimated": {
          "type": ["boolean", "null"]
        },
        "group_power": {
          "type": "object"
        },
        "cached_prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "metric_sources": {
          "type": "object"
        },
        "recorded_metric_sources": {
          "type": "object",
          "description": "Original sources retained when explicit derivation replaces recorded rates."
        },
        "derived_metrics": {
          "type": "object",
          "description": "Explicit export-only derived rates and their scopes; null denotes insufficient evidence."
        },
        "reported_timings": {
          "type": "object",
          "description": "Provider-reported timing fields, kept separate from client metrics."
        },
        "timing_scope": {
          "type": "object",
          "properties": {
            "phase_protocol": {"type": "string"},
            "decode_end_boundary": {"type": "string", "description": "Machine-readable observed decode endpoint; absent for older measurements."}
          }
        },
        "decode_token_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "quantization": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "quantization_source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "quantization_method": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "quantization_method_source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "maxLength": 250
        },
        "engine_version": {
          "type": "string",
          "maxLength": 250
        },
        "model_revision": {
          "type": "string",
          "maxLength": 250
        },
        "quantization": {
          "type": "string",
          "maxLength": 250
        },
        "kv_cache_dtype": {
          "type": "string",
          "maxLength": 250
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "mtp_draft_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      }
    },
    "performanceClaims": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "precision",
          "value",
          "unit",
          "kind",
          "sparsity",
          "source",
          "execution_path"
        ],
        "properties": {
          "precision": {
            "enum": [
              "FP4",
              "INT4",
              "FP8",
              "INT8",
              "FP16",
              "BF16",
              "FP32"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "enum": [
              "TOPS",
              "TFLOP/s"
            ]
          },
          "kind": {
            "enum": [
              "advertised_peak",
              "measured",
              "estimate"
            ]
          },
          "sparsity": {
            "enum": [
              "dense",
              "sparse",
              "unknown"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "execution_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "provenance": {
            "const": "user_reported"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "precision": {
                  "enum": [
                    "INT4",
                    "INT8"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "unit": {
                  "const": "TOPS"
                }
              }
            },
            "else": {
              "properties": {
                "unit": {
                  "const": "TFLOP/s"
                }
              }
            }
          }
        ]
      }
    }
  }
}
